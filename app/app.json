{
  "expo": {
    "name": "ClearSky",
    "slug": "clearsky",
    "scheme": "clearsky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1B3A"
    },
    "ios": {
      "bundleIdentifier": "com.yourcompany.clearsky",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ClearSky uses your location to show the forecast and rain alerts where you are.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourcompany.clearsky",
      "adaptiveIcon": {
        "backgroundColor": "#0B1B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ClearSky uses your location to show the forecast and rain alerts where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F80ED"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "REPLACE_ORG",
          "project": "clearsky"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ebc7ea4f-c2b1-4a2c-ad59-e2f52fa503b9"
      }
    },
    "owner": "himanshux646"
  }
}
