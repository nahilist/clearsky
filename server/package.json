{
  "name": "clearsky-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/main.mjs --packages=external",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-timeout=120000 src/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.119.2",
    "expo-server-sdk": "^8.0.0",
    "fastify": "^5.12.8",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
